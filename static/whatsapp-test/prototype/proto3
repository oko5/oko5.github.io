const header = document.querySelector('[data-testid="conversation-header"]');

if (header) {
    const element = header.firstElementChild?.children[1];

    if (element) {

        // Open group information
        element.dispatchEvent(new MouseEvent('mousedown', {
            bubbles: true,
            cancelable: true,
            view: window
        }));

        element.dispatchEvent(new MouseEvent('mouseup', {
            bubbles: true,
            cancelable: true,
            view: window
        }));

        element.dispatchEvent(new MouseEvent('click', {
            bubbles: true,
            cancelable: true,
            view: window
        }));

        setTimeout(() => {

            // ---------------------------------------------------------
            // MEMBER COUNT
            // ---------------------------------------------------------

            const membersButton = [...document.querySelectorAll('button')]
                .find(btn =>
                    /^\d+\s+members$/.test(btn.textContent.trim())
                );


            // ---------------------------------------------------------
            // GROUP NAME
            // ---------------------------------------------------------

            const groupNameElement = document.querySelector(
                '[data-testid^="group-info-drawer-subject-input-read-only"]'
            );


            // ---------------------------------------------------------
            // ADMINS
            // ---------------------------------------------------------

            const admin = [];

            const adminMarkers = document.querySelectorAll(
                '[data-testid="group-admin-marker"]'
            );

            adminMarkers.forEach(marker => {

                const row = marker.closest(
                    '[data-testid^="list-item-"]'
                );

                if (!row) {
                    return;
                }

                const nameElement = row.querySelector(
                    '[data-testid="cell-frame-title"] span[dir="auto"][title]'
                );

                if (!nameElement) {
                    return;
                }

                const name =
                    nameElement.getAttribute('title') ||
                    nameElement.textContent.trim();

                if (name && !admin.includes(name)) {
                    admin.push(name);
                }
            });


            // ---------------------------------------------------------
            // GROUP OWNER
            // ---------------------------------------------------------

            const ownerElement = [...document.querySelectorAll('span')]
                .find(span =>
                    span.textContent.trim().startsWith('Group created by ')
                );

            let owner = null;

            if (ownerElement) {

                const ownerText = ownerElement.textContent.trim();

                const match = ownerText.match(
                    /^Group created by (.*?),\s*on\s/
                );

                if (match) {
                    owner = match[1].trim();
                }
            }


            // ---------------------------------------------------------
            // INITIAL DATA
            // ---------------------------------------------------------

            const data = {
                groupName:
                    groupNameElement?.textContent.trim() || null,

                members:
                    membersButton?.textContent.trim() || null,

                admin: admin,

                owner: owner
            };

            console.log(
                'Group information:',
                JSON.stringify(data, null, 2)
            );


            // ---------------------------------------------------------
            // CHECK ADMIN
            // ---------------------------------------------------------

            if (!admin.includes('You')) {
                console.error('You are not an admin');
            } else {
                console.log('You are an admin');
            }


            // ---------------------------------------------------------
            // FIND VIEW ALL
            // ---------------------------------------------------------

            const viewAll = [...document.querySelectorAll('div')]
                .find(div =>
                    /^View all \(\d+ more\)$/.test(
                        div.textContent.trim()
                    )
                );

            if (!viewAll) {
                console.log('View all element not found');
                return;
            }


            // ---------------------------------------------------------
            // CLICK VIEW ALL
            // ---------------------------------------------------------

            viewAll.dispatchEvent(new MouseEvent('mousedown', {
                bubbles: true,
                cancelable: true,
                view: window
            }));

            viewAll.dispatchEvent(new MouseEvent('mouseup', {
                bubbles: true,
                cancelable: true,
                view: window
            }));

            viewAll.dispatchEvent(new MouseEvent('click', {
                bubbles: true,
                cancelable: true,
                view: window
            }));

            console.log(
                'Clicked:',
                viewAll.textContent.trim()
            );


            // ---------------------------------------------------------
            // WAIT FOR CONTACTS MODAL
            // ---------------------------------------------------------

            const modalTimer = setInterval(() => {

                const contactsModal = document.querySelector(
                    '[data-testid="contacts-modal"]'
                );

                if (!contactsModal) {
                    return;
                }

                clearInterval(modalTimer);

                console.log(
                    'Search members modal detected'
                );


                // -----------------------------------------------------
                // GET CURRENTLY LOADED MEMBERS
                // -----------------------------------------------------

                function getMembers() {

                    const rows = [
                        ...contactsModal.querySelectorAll(
                            '[data-testid="cell-frame-container"]'
                        )
                    ];

                    const members = [];

                    rows.forEach(row => {

                        const nameElement = row.querySelector(
                            '[data-testid="cell-frame-title"] span[dir="auto"][title]'
                        );

                        if (!nameElement) {
                            return;
                        }

                        const name =
                            nameElement.getAttribute('title') ||
                            nameElement.textContent.trim();

                        if (!name) {
                            return;
                        }

                        const isAdmin =
                            !!row.querySelector(
                                '[data-testid="group-admin-marker"]'
                            );

                        const alreadyExists = members.some(
                            member => member.name === name
                        );

                        if (!alreadyExists) {
                            members.push({
                                name: name,
                                isAdmin: isAdmin
                            });
                        }
                    });

                    return members;
                }


                // -----------------------------------------------------
                // FIND SCROLLABLE MEMBER CONTAINER
                // -----------------------------------------------------

                function findScrollContainer() {

                    const elements = [
                        ...contactsModal.querySelectorAll('div')
                    ];

                    let best = null;

                    elements.forEach(div => {

                        const style =
                            window.getComputedStyle(div);

                        const canScroll =
                            div.scrollHeight > div.clientHeight;

                        const correctOverflow =
                            style.overflowY === 'auto' ||
                            style.overflowY === 'scroll';

                        if (
                            canScroll &&
                            correctOverflow
                        ) {

                            if (
                                !best ||
                                div.scrollHeight > best.scrollHeight
                            ) {
                                best = div;
                            }
                        }
                    });

                    return best;
                }


                // -----------------------------------------------------
                // STORE ALL MEMBERS
                // -----------------------------------------------------

                const allMembers = new Map();

                function collectMembers() {

                    const currentMembers = getMembers();

                    currentMembers.forEach(member => {

                        const existing =
                            allMembers.get(member.name);

                        if (!existing) {

                            allMembers.set(
                                member.name,
                                member
                            );

                        } else if (member.isAdmin) {

                            existing.isAdmin = true;
                        }
                    });
                }


                // -----------------------------------------------------
                // FINISH
                // -----------------------------------------------------

                function finishMembers() {

                    collectMembers();

                    const members = [
                        ...allMembers.values()
                    ];

                    members.forEach(member => {

                        if (
                            member.isAdmin &&
                            !admin.includes(member.name)
                        ) {
                            admin.push(member.name);
                        }
                    });


                    const finalData = {

                        groupName:
                            groupNameElement?.textContent.trim() ||
                            null,

                        members:
                            membersButton?.textContent.trim() ||
                            `${members.length} members`,

                        memberList:
                            members,

                        memberNames:
                            members.map(member => member.name),

                        admin:
                            admin,

                        owner:
                            owner
                    };


                    console.log(
                        'ALL GROUP MEMBERS:'
                    );

                    console.log(
                        JSON.stringify(
                            finalData,
                            null,
                            2
                        )
                    );

                    console.log(
                        `Fetched ${members.length} member(s)`
                    );


                    if (admin.includes('You')) {

                        console.log(
                            'You are an admin'
                        );

                    } else {

                        console.error(
                            'You are not an admin'
                        );
                    }
                }


                // -----------------------------------------------------
                // FIND MEMBER SCROLLER
                // -----------------------------------------------------

                const scrollContainer =
                    findScrollContainer();


                if (!scrollContainer) {

                    console.warn(
                        'Member scroll container not found'
                    );

                    collectMembers();
                    finishMembers();

                    return;
                }


                console.log(
                    'Member scroll container found'
                );


                // -----------------------------------------------------
                // SCROLL THROUGH VIRTUALIZED LIST
                // -----------------------------------------------------

                let previousCount = 0;
                let unchangedRounds = 0;
                let rounds = 0;

                function scrollMembers() {

                    rounds++;

                    collectMembers();

                    const currentCount =
                        allMembers.size;

                    if (currentCount === previousCount) {
                        unchangedRounds++;
                    } else {
                        unchangedRounds = 0;
                    }

                    previousCount = currentCount;


                    const atBottom =
                        scrollContainer.scrollTop +
                        scrollContainer.clientHeight >=
                        scrollContainer.scrollHeight - 10;


                    if (
                        atBottom ||
                        unchangedRounds >= 8 ||
                        rounds >= 100
                    ) {

                        finishMembers();
                        return;
                    }


                    scrollContainer.scrollTop += Math.max(
                        300,
                        scrollContainer.clientHeight * 0.8
                    );


                    setTimeout(
                        scrollMembers,
                        250
                    );
                }


                scrollMembers();

            }, 100);


            // ---------------------------------------------------------
            // SAFETY TIMEOUT
            // ---------------------------------------------------------

            setTimeout(() => {
                clearInterval(modalTimer);
            }, 15000);

        }, 100);

    } else {

        console.error(
            'Could not find group information button'
        );
    }

} else {

    console.error(
        'Could not find conversation header'
    );
}
